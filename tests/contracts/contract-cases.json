    { "file": "reviewer-valid.json", "schema": "reviewer", "expected": "valid" },
    { "file": "reviewer-invalid-confidence.json", "schema": "reviewer", "expected": "invalid" },

    { "file": "run-valid.json", "schema": "run", "expected": "valid" },
