# redAI PERSONAL v1 — TARGET CONFIG CONTRACT, NOT A RUNNABLE APPLICATION
# Các biến sẽ được coding agent triển khai và kiểm tra trong T28.
# Không chứa secret thật. Không commit bản .env có secret.
REDAI_ENV=production
REDAI_BIND_HOST=127.0.0.1
REDAI_PUBLIC_ORIGIN=https://redai.example.test
REDAI_TIMEZONE=Asia/Bangkok
REDAI_DATABASE_URL_FILE=/run/secrets/redai_database_url
REDAI_MASTER_KEY_FILE=/run/secrets/redai_master_key
REDAI_LEASE_SIGNING_KEY_FILE=/run/secrets/redai_lease_signing_key
REDAI_OBJECT_ROOT=/var/lib/redai/objects
REDAI_BACKUP_ROOT=/var/lib/redai/backups
REDAI_LOG_ROOT=/var/log/redai
REDAI_TELEMETRY_ENABLED=false
REDAI_ALLOW_PUBLIC_REGISTRATION=false
REDAI_ALLOW_CLOUD_SANDBOX=false
REDAI_DEFAULT_APPROVAL_MODE=automatic
REDAI_DEFAULT_DATA_MODE=redacted_cloud
REDAI_EXECUTION_ENABLED=false
REDAI_WORKSPACE_MAX_ACTIVE_RUNS=2
REDAI_RUNTIME_LEASE_SECONDS=60
REDAI_RUNTIME_RENEW_SECONDS=15
REDAI_EVENT_RETENTION_DAYS=30
REDAI_LOG_RETENTION_DAYS=30
# Worker được enroll riêng, không dùng chung credential giữa các installation.
REDAI_WORKER_CONTROL_URL=https://redai.example.test
REDAI_WORKER_CREDENTIAL_FILE=/var/lib/redai-worker/credential
REDAI_WORKER_STATE_ROOT=/var/lib/redai-worker
REDAI_WORKER_RUNTIME=runsc
REDAI_WORKER_ZONE=lab
REDAI_WORKER_CAPACITY=2
REDAI_WORKER_HEARTBEAT_SECONDS=5
REDAI_WORKER_RENEW_SECONDS=10
REDAI_WORKER_LEASE_SECONDS=45
REDAI_WORKER_SAFETY_MARGIN_SECONDS=5
REDAI_WORKER_KILL_GRACE_SECONDS=5
REDAI_WORKER_CLAIM_WAIT_SECONDS=20
# Image digest phải được sinh từ build thật/pinned trong T18; không điền latest.
# REDAI_WORKER_IMAGE_DIGEST=sha256:<digest-from-approved-build>
# Không lưu model key ở file này; owner tạo provider/secret qua giao diện.
