{
  "name": "redai",
  "version": "0.0.0",
  "private": true,
  "description": "redAI Personal v1 \u2014 self-hosted single-owner security workbench (monorepo root)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "env:check": "node scripts/check-env.mjs",
    "typecheck": "tsc -b && pnpm --filter @redai/web run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "build": "tsc -b && pnpm -r --if-present run build",
    "boundary": "vitest run tests/import-boundary",
    "go:check": "cd worker && go vet ./... && go build ./... && go test ./...",
    "check": "pnpm run env:check && pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run test && pnpm run build && pnpm run go:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
