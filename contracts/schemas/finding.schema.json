{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redai.invalid/v1/finding.schema.json",
  "title": "redAI finding",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "affected_asset_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        {
          "type": "null"
        }
      ]
    },
    "affected_origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "cwe": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^CWE-[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "severity_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "candidate",
        "needs_review",
        "verified",
        "rejected",
        "inconclusive"
      ]
    },
    "remediation_status": {
      "type": "string",
      "enum": [
        "open",
        "fixed",
        "accepted_risk"
      ]
    },
    "impact": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "observed_behavior": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "reproduction": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "remediation": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/UUID"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 50
    },
    "source_run_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_confirmed": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "project_id",
    "version",
    "title",
    "summary",
    "affected_asset_id",
    "affected_origin",
    "category",
    "cwe",
    "severity",
    "severity_rationale",
    "confidence",
    "verification_status",
    "remediation_status",
    "impact",
    "observed_behavior",
    "expected_behavior",
    "reproduction",
    "remediation",
    "evidence_ids",
    "limitations",
    "source_run_id",
    "owner_confirmed",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
