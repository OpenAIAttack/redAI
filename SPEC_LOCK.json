{
  "spec_version": "1.0.0-draft.1",
  "date": "2026-09-24",
  "product": "redAI Personal v1",
  "audience": "single_owner",
  "workspace_count": 1,
  "architecture": {
    "web": "Next.js + React + TypeScript",
    "api": "Fastify + TypeScript",
    "runtime": "TypeScript process + PostgreSQL durable state machine",
    "worker": "Go on Linux",
    "database_major": 18,
    "object_store_v1": "local_filesystem_adapter",
    "ui_realtime": "SSE",
    "worker_transport": "outbound HTTPS JSON long-poll",
    "temporal_required": false,
    "redis_required": false,
    "cloud_sandbox_required": false,
    "billing": false
  },
  "defaults": {
    "approval_mode": "automatic",
    "ui_language": "vi",
    "timezone": "Asia/Bangkok",
    "theme": "dark",
    "data_mode_after_cloud_setup": "redacted_cloud",
    "max_active_runs_workspace": 2,
    "max_active_runs_chat": 1,
    "max_children": 2,
    "max_child_depth": 1,
    "worker_capacity": 2,
    "max_steps": 40,
    "active_timeout_seconds": 1800,
    "absolute_timeout_seconds": 86400,
    "budget_micro_usd": "2000000",
    "tool_timeout_seconds": 120,
    "tool_timeout_max_seconds": 600,
    "approval_ttl_seconds": 900,
    "enrollment_ttl_seconds": 600,
    "worker_credential_ttl_seconds": 2592000,
    "worker_heartbeat_seconds": 5,
    "worker_renew_seconds": 10,
    "worker_lease_seconds": 45,
    "worker_safety_margin_seconds": 5,
    "worker_kill_grace_seconds": 5,
    "worker_claim_wait_seconds": 20,
    "upload_max_bytes": 26214400,
    "upload_batch_max_bytes": 209715200,
    "worker_spool_max_bytes": 67108864,
    "preview_max_bytes": 1048576,
    "idempotency_ttl_seconds": 86400,
    "events_retention_days": 30,
    "logs_retention_days": 30,
    "runtime_lease_seconds": 60,
    "runtime_renew_seconds": 15,
    "max_parallel_tools": 2
  },
  "security_invariants": {
    "default_network_without_grant": "offline",
    "third_party_authorization": "explicit_only",
    "worker_fallback": "only_explicit_bound_pool_before_start",
    "unsafe_effect_replay": "never_without_reconciliation",
    "raw_secret_in_model": false,
    "sandbox_host_shell": false,
    "sandbox_docker_socket": false,
    "production_runtime": "runsc",
    "browser_https_boundary": "inspecting_scope_proxy_no_blind_connect"
  },
  "approval_modes": [
    "automatic",
    "always_ask",
    "ask_high_risk",
    "reject"
  ],
  "run_states": [
    "queued",
    "running",
    "waiting_approval",
    "waiting_worker",
    "paused",
    "cancel_requested",
    "cancellation_pending",
    "needs_attention",
    "completed",
    "failed",
    "canceled",
    "expired"
  ],
  "attempt_states": [
    "queued",
    "leased",
    "started",
    "uploading",
    "succeeded",
    "failed",
    "cancel_requested",
    "canceled",
    "lost",
    "unknown"
  ],
  "effect_classes": [
    "pure",
    "sandbox_write",
    "external_read",
    "external_write",
    "destructive",
    "unknown"
  ]
}
